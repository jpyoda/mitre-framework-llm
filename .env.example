# Copy to .env.local and fill in. All variables are optional.

# Server-side OpenAI key. If unset, each user must enter their own key in the
# sidebar; it is sent to this server per request and never stored or logged.
OPENAI_API_KEY=

# Model used for scenarios (default: gpt-5-mini).
LLM_MODEL=

# OpenAI-compatible endpoint, e.g. Azure OpenAI or a local server such as
# Ollama (http://localhost:11434/v1) or vLLM. Leave empty for api.openai.com.
OPENAI_BASE_URL=

# Scenarios per client IP per hour when the server key is used (default 10).
# 0 turns the limit off. Requests with a user's own key are not limited.
# The limit is kept in memory, per server process.
SCENARIO_RATE_LIMIT=
